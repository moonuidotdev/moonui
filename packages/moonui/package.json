{
  "name": "@moontra/moonui",
  "version": "6.30.0",
  "description": "Premium React component library with modern design and customization",
  "author": "MoonUI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oguzhanayyldz/moonuikit.git"
  },
  "homepage": "https://github.com/oguzhanayyldz/moonuikit",
  "bugs": {
    "url": "https://github.com/oguzhanayyldz/moonuikit/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "unpkg": "dist/cdn/moonui.global.js",
  "jsdelivr": "dist/cdn/moonui.global.js",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/**",
    "src/**",
    "README.md",
    "LICENSE",
    "tailwind-preset.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/lib/theme.d.ts",
      "import": "./dist/lib/theme.mjs",
      "require": "./dist/lib/theme.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.mjs",
      "require": "./dist/hooks/index.js"
    },
    "./tokens.css": "./src/styles/tokens.css",
    "./design-system.css": "./src/styles/design-system.css",
    "./package.json": "./package.json",
    "./tailwind-preset": "./tailwind-preset.js"
  },
  "keywords": [
    "ui",
    "components",
    "design-system",
    "react",
    "nextjs",
    "tailwindcss",
    "radix-ui",
    "open-source",
    "mit-license",
    "free-components",
    "community-driven"
  ],
  "scripts": {
    "dev": "npm run build -- --watch",
    "build": "npm run build:js && npm run build:dts && node scripts/postbuild.js && npm run build:cdn",
    "build:js": "tsup",
    "build:dts": "tsup --dts-only",
    "build:cdn": "npm run build:cdn:js && npm run build:cdn:css",
    "build:cdn:js": "tsup --config tsup.cdn.config.ts",
    "build:cdn:css": "tailwindcss -c tailwind.cdn.config.js -i src/styles/cdn.css -o dist/cdn/moonui.css --minify",
    "verify:cdn": "node scripts/cdn/verify-cdn.mjs",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "cd ../.. && npx jest packages/moonui --coverage",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^3.0.0 || ^4.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.10",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.6",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.525.0",
    "tailwind-merge": "^2.5.0",
    "date-fns": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^18.16.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.39.0",
    "eslint-config-next": "^13.4.9",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-tailwindcss": "^3.13.0",
    "glob": "^11.0.3",
    "postcss": "^8.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.17",
    "tsup": "^7.1.0",
    "typescript": "^5.1.6"
  },
  "style": "src/styles/tokens.css",
  "publishConfig": {
    "access": "public"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/oguzhanayyldz"
  },
  "contributors": [
    {
      "name": "Oğuzhan Ayyıldız",
      "url": "https://github.com/oguzhanayyldz"
    }
  ]
}
